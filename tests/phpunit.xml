<!--
  Tests in the "quarantine" group reveal a product bug that has its own issue
  (named in the test's docblock). CI excludes them with exclude-group quarantine.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="./TestHelper.php"
         backupGlobals="false"
         backupStaticAttributes="false"
         verbose="true"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false">
    <!--
      The whole suite loads docs/generated/graph.json (several MB once decoded) in more than one test;
      the CLI default of 128M is too tight for one process running all of it.
    -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
    <testsuites>
        <testsuite name="Gaia">
            <directory>.</directory>
            <exclude>./tools/gaia-dev/fixtures</exclude>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">../app/models</directory>
        </include>
    </coverage>
</phpunit>
