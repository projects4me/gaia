    {
      "id": "acl-perm-create-module-action",
      "method": "POST",
      "path": "/api/v1/permission",
      "resource": "permission",
      "auth": true,
      "body": {
        "data": {
          "type": "permission",
          "attributes": {
            "resourceName": "tag.get",
            "allowed": "1",
            "roleId": "{developerRoleId}"
          }
        }
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource",
        "attributesEqual": {
          "resourceName": "tag.get",
          "allowed": "1",
          "roleId": "{developerRoleId}"
        }
      },
      "store": { "runtime.tagGetPermissionId": "data.id" },
      "source": "acl-permission"
    },
    {
      "id": "acl-perm-reject-direct-field-action-triple",
      "method": "POST",
      "path": "/api/v1/permission",
      "resource": "permission",
      "auth": true,
      "body": {
        "data": {
          "type": "permission",
          "attributes": {
            "resourceName": "issue.subject.get",
            "allowed": "1",
            "roleId": "{developerRoleId}"
          }
        }
      },
      "expects": {
        "status": 422,
        "shape": "error",
        "errorEqual": "Field action permissions cannot be set directly"
      },
      "source": "acl-permission"
    },
