    },
    {
      "id": "live-issue-patch-status-succeeds-when-hermes-unreachable-fail-open",
      "method": "PATCH",
      "path": "/api/v1/issue/{runtime.failOpenIssueId}",
      "resource": "issue",
      "auth": true,
      "body": {
        "data": {
          "type": "issue",
          "id": "{runtime.failOpenIssueId}",
          "attributes": {
            "statusId": "{runtime.failOpenStatusId}"
          }
        }
      },
      "expects": {
        "status": 200,
        "shape": "jsonapi.resource"
      },
      "hermes": {
        "requireUp": false
      }
    },
    {
      "id": "live-conversationroom-create-succeeds-when-hermes-unreachable-fail-open",
      "method": "POST",
      "path": "/api/v1/conversationroom",
      "resource": "conversationroom",
      "auth": true,
      "body": {
        "data": {
          "type": "conversationroom",
          "attributes": {
            "subject": "Fail-Open Room {runId}",
            "roomType": "discussion",
            "projectId": "{projectId}",
            "projectShortcode": "{projectShortcode}"
          }
        }
      },
      "store": {
        "runtime.failOpenConversationroomId": "data.id"
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource"
      },
      "hermes": {
        "requireUp": false
      }
    },
    {
      "id": "live-conversation-comment-create-succeeds-when-hermes-unreachable-fail-open",
      "method": "POST",
      "path": "/api/v1/comment",
      "resource": "comment",
      "auth": true,
      "body": {
        "data": {
          "type": "comment",
          "attributes": {
            "comment": "Fail-open comment {runId}",
            "relatedTo": "conversationrooms",
            "relatedId": "{runtime.failOpenConversationroomId}"
          }
        }
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource"
      },
      "hermes": {
        "requireUp": false
      }
    }
  ]
}
