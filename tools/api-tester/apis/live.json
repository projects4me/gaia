      "body": {
        "data": {
          "type": "issue",
          "attributes": {
            "subject": "Live Hermes Fail-Open Issue {runId}",
            "owner": "{userId}",
            "assignee": "{userId}",
            "reportedUser": "{userId}",
            "typeId": "{issuetypeId}",
            "priority": "medium",
            "projectId": "{projectId}",
            "projectShortcode": "{projectShortcode}",
            "statusId": "{issuestatusId}",
            "isPlanned": 0,
            "isReopened": 0
          }
        }
      },
      "store": {
        "runtime.failOpenIssueId": "data.id"
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource"
      },
      "hermes": {
        "requireUp": false
