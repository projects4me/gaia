{
  "description": "Gaia → Hermes live publish smoke cases. Happy-path cases need --hermes-url. Fail-open cases need Gaia with unreachable HERMES_URL (filter fail-open).",
  "apis": [
    {
      "id": "live-setup-issuestatus-for-status-change",
      "method": "POST",
      "path": "/api/v1/issuestatus",
      "resource": "issuestatus",
      "auth": true,
      "body": {
        "data": {
          "type": "issuestatus",
          "attributes": {
            "name": "ls-{runId}",
            "system": 0,
            "done": 0,
            "projectId": "{projectId}"
          }
        }
      },
      "store": {
        "runtime.liveStatusId": "data.id"
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource"
      }
    },
    {
      "id": "live-issue-create-publishes-issue-created",
      "method": "POST",
      "path": "/api/v1/issue",
      "resource": "issue",
      "auth": true,
      "body": {
        "data": {
          "type": "issue",
          "attributes": {
            "subject": "Live Hermes Issue {runId}",
            "owner": "{userId}",
            "assignee": "{userId}",
            "reportedUser": "{userId}",
            "typeId": "{issuetypeId}",
            "priority": "medium",
            "projectId": "{projectId}",
            "projectShortcode": "{projectShortcode}",
            "statusId": "{issuestatusId}",
            "isPlanned": 0,
            "isReopened": 0
          }
        }
      },
      "store": {
        "runtime.liveIssueId": "data.id"
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource"
      },
      "hermes": {
        "expect": [
          {
            "eventName": "issue.created",
            "projectId": "{projectId}",
            "resourceType": "issue"
          }
        ],
        "timeoutMs": 5000
      }
    },
    {
      "id": "live-issue-patch-status-publishes-issue-status-changed",
      "method": "PATCH",
      "path": "/api/v1/issue/{runtime.liveIssueId}",
      "resource": "issue",
      "auth": true,
      "body": {
        "data": {
          "type": "issue",
          "id": "{runtime.liveIssueId}",
          "attributes": {
            "statusId": "{runtime.liveStatusId}"
          }
        }
      },
      "expects": {
        "status": 200,
        "shape": "jsonapi.resource"
      },
      "hermes": {
        "expect": [
          {
            "eventName": "issue.status.changed",
            "projectId": "{projectId}",
            "resourceType": "issue",
            "resourceId": "{runtime.liveIssueId}"
          }
        ],
        "timeoutMs": 5000
      }
    },
    {
