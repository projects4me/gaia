        "page": 1
      }
    },
    {
      "id": "post-comment-api-v1-comment",
      "method": "POST",
      "path": "/api/v1/comment",
      "resource": "comment",
      "auth": true,
      "body": {
        "data": {
          "type": "comment",
          "attributes": {
            "relatedTo": "conversationrooms",
            "relatedId": "{conversationroomId}",
            "comment": "<p>API Tester Runtime Comment</p>"
          }
        }
      },
      "store": {
        "runtime.commentId": "data.id"
      },
      "expects": {
        "status": 201,
        "shape": "jsonapi.resource",
        "attributesPresent": [
          "relatedTo",
          "relatedId",
          "comment"
        ],
        "attributesEqual": {
          "relatedTo": "conversationrooms",
          "relatedId": "{conversationroomId}",
          "comment": "<p>API Tester Runtime Comment</p>"
        }
      }
    },
